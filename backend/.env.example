# ── DATIL API ──────────────────────────────────────────────
# Obtén tu API Key en: app.datil.co → Configuración → API Key
DATIL_API_KEY=tu-api-key-aqui

# Contraseña del certificado digital (.p12)
DATIL_CERT_PASSWORD=tu-contrasena-certificado

# 1 = Pruebas (no genera facturas reales)
# 2 = Producción (facturas reales ante el SRI)
DATIL_AMBIENTE=1

# ── DATOS DEL EMISOR (tu restaurante) ──────────────────────
EMISOR_RUC=1234567890001
EMISOR_RAZON_SOCIAL=Mi Restaurante S.A.
EMISOR_NOMBRE_COMERCIAL=Mi Restaurante
EMISOR_DIRECCION=Av. Principal 123, Quito, Ecuador
EMISOR_PUNTO_EMISION=001
EMISOR_ESTABLECIMIENTO=001
# true si está obligado a llevar contabilidad, false si no
EMISOR_OBLIGADO=false

# ── CONFIGURACIÓN DE PRECIOS ────────────────────────────────
# true  → los precios del menú YA incluyen IVA (se back-calcula la base)
# false → los precios del menú son sin IVA (se agrega 15% encima)
PRECIOS_CON_IVA=true

# ── SERVIDOR ────────────────────────────────────────────────
PORT=3000

# ── CORS: URL de tu GitHub Pages ───────────────────────────
FRONTEND_URL=https://raulc4619-svg.github.io
